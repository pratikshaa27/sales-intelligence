APP_ENV=development
APP_NAME=sales-intelligence-platform
API_BASE_URL=http://localhost:8010
FRONTEND_URL=http://localhost:3002

# Used by docker-compose to configure the postgres container; the backend's DATABASE_URL is
# assembled from these in docker-compose.yml so they only need to be set once.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sales_intelligence

# Host-side port mappings. Defaults deliberately avoid the common 5432/8000/3000/6379 in case
# another project on the same machine is already using them; only the host side changes here —
# containers still talk to each other over the internal Docker network on their normal ports.
POSTGRES_PORT=5434
REDIS_PORT=6379
BACKEND_PORT=8010
FRONTEND_PORT=3002

# DATABASE_URL/REDIS_URL below are for running the backend OUTSIDE Docker (e.g. a local venv);
# inside docker-compose, the backend/worker services set these themselves using the
# service hostnames (postgres/redis) rather than localhost.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/sales_intelligence
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ALLOWED_ORIGINS=["http://localhost:3002"]

# AI provider: "mock" (default, deterministic local responses, no network/API key needed) or
# "openai_compatible" (OpenAI itself, or any OpenAI-compatible endpoint incl. local Ollama/vLLM).
AI_PROVIDER=mock
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=your-model-name
EMBEDDING_MODEL=your-embedding-model

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com

SENTRY_DSN=
LOG_LEVEL=INFO

NEXT_PUBLIC_API_BASE_URL=http://localhost:8010/api/v1

# Never commit a real .env file with production secrets.
